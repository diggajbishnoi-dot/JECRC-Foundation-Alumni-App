# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
# Comma-separated trusted frontend origins. Use '*' for local dev only.
# In production, set this to your actual frontend domain, e.g.:
# CORS_ORIGIN=https://alumni.jecrcfoundation.com
CORS_ORIGIN=*

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alumni_db?schema=public"

# Redis Configuration (Cache, Rate Limiting, Presence)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="alumni_super_secret_jwt_access_key_2026_x99"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="alumni_super_secret_jwt_refresh_key_2026_z88"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 Storage (Profile pics, Resumes, Post attachments)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="mock_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="mock_aws_secret_access_key"
AWS_S3_BUCKET="alumni-app-storage"

# Firebase Cloud Messaging (FCM Push Notifications)
FIREBASE_PROJECT_ID="alumni-app-firebase"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@alumni-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMOCK_KEY\n-----END PRIVATE KEY-----"

# SMS OTP Provider (Twilio / MSG91)
SMS_PROVIDER="TWILIO"
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15005550006"
MSG91_AUTH_KEY="mock_msg91_auth_key"
MSG91_SENDER_ID="ALUMNI"

# Email OTP Provider (SMTP / SendGrid)
EMAIL_PROVIDER="SMTP"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="mock_smtp_user"
SMTP_PASS="mock_smtp_password"
EMAIL_FROM="noreply@alumniapp.edu"
